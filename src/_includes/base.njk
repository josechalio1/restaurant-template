<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} | {{ site.businessName }}</title>
  <meta name="description" content="{{ description or site.hero.sub }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,600;0,700;1,600&family=Work+Sans:wght@400;500&family=Oswald:wght@500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": ["LocalBusiness", "Restaurant"],
    "name": "{{ site.businessName }}",
    "servesCuisine": "{{ site.cuisine }}",
    "priceRange": "{{ site.priceRange }}",
    "telephone": "{{ site.phoneHref }}",
    "email": "{{ site.email }}",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "{{ site.address.street }}",
      "addressLocality": "{{ site.address.city }}",
      "addressRegion": "{{ site.address.state }}",
      "postalCode": "{{ site.address.zip }}"
    },
    "openingHoursSpecification": [
      {% for h in site.hoursSchema %}
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": "{{ h.day }}",
        "opens": "{{ h.opens }}",
        "closes": "{{ h.closes }}"
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ],
    "sameAs": [
      "{{ site.social.instagram }}",
      "{{ site.social.facebook }}"
    ]
  }
  </script>
</head>
<body>
  {% include "header.njk" %}
  <main id="main">
    {{ content | safe }}
  </main>
  {% include "footer.njk" %}
  <script src="/js/nav.js" defer></script>
</body>
</html>
